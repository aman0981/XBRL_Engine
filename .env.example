# Copy to `.env` and fill in real values; .env is auto-loaded by docker compose.
# Do NOT commit your filled-in .env (.gitignore already excludes it).

# Postgres credentials used by both the postgres service and the app's
# XIE_DATABASE_URL (constructed from these in docker-compose.yml).
POSTGRES_USER=xie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xie
